{
  "name": "biosphere",
  "private": true,
  "type": "module",
  "description": "A browser-based, peer-to-peer creature-evolution game.",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "sim:pacing": "node tools/pacing.mjs",
    "report:diversity": "node tools/diversity.mjs",
    "report:speed": "node tools/speed.mjs",
    "report:combat": "node tools/combat.mjs",
    "report:storage": "node tools/storage.mjs",
    "report:capacity": "node tools/capacity.mjs",
    "report:hub": "node tools/hub.mjs",
    "load:hub": "node tools/load-hub.mjs",
    "report:farm": "node tools/farm.mjs",
    "report:witness": "node tools/witness.mjs",
    "report:net": "node tools/net.mjs",
    "report:aoi": "node tools/aoi.mjs",
    "sim:wave": "node tools/wave.mjs",
    "sim:load": "node --expose-gc --max-old-space-size=12000 tools/load.mjs",
    "verify:lineage": "node tools/lineage.mjs",
    "gallery": "node tools/gallery.mjs",
    "report:budget": "node tools/budget-report.mjs",
    "specimens": "node tools/specimens.mjs",
    "record:drand": "node tools/record-drand.mjs",
    "goldens:manifest": "node tools/goldens.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "check": "biome check . && tsc --noEmit && tsc --noEmit -p worker && vitest run --tags-filter='!heavy'",
    "check:full": "biome check . && tsc --noEmit && tsc --noEmit -p worker && vitest run --tags-filter='!speed' && vitest run --tags-filter=speed --no-file-parallelism",
    "format": "biome check --write .",
    "test:unit": "vitest",
    "worker:dev": "node tools/worker.mjs dev",
    "worker:deploy": "node tools/worker.mjs deploy",
    "test:e2e": "E2E_SKIP_SLOW=1 playwright test",
    "test:e2e:full": "playwright test",
    "e2e:setup": "playwright install --with-deps --only-shell chromium",
    "verify": "npm run check:full && npm run build && npm run test:e2e:full"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/ed25519": "^3.2.0",
    "@noble/hashes": "^2.4.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@cloudflare/vitest-plugin": "1.4.10",
    "@cloudflare/workers-types": "5.20261029.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "4.155.0"
  }
}
