{
  "name": "biosphere",
  "private": true,
  "type": "module",
  "description": "A browser-based, peer-to-peer creature-evolution game.",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "biome check . && tsc --noEmit && vitest run",
    "format": "biome check --write .",
    "test:unit": "vitest",
    "test:e2e": "playwright test --grep-invert @slow",
    "test:e2e:full": "playwright test",
    "e2e:setup": "playwright install --with-deps --only-shell chromium",
    "verify": "npm run check && npm run build && npm run test:e2e:full"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
